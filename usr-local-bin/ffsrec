#!/usr/bin/env bash
today=$(date +"%Y-%m-%d")

name="$(dmenu -fn "monospace:size=14" -nb "#222222" -nf "#bbbbbb" -sb "#d8bb6d" -sf "#222222" -p "video name" < /dev/null)"

cd /home/nyquist/Videos/casts/

file="${today}--${name:-VID}.mp4"

ffmpeg \
    -f x11grab \
    -video_size 1920x1080 \
    -framerate 60 \
    -i "$DISPLAY" \
    -f pulse -i alsa_output.pci-0000_00_1f.3.analog-stereo.monitor \
    -f pulse -i alsa_input.pci-0000_00_1f.3.analog-stereo \
    -filter_complex "\
[2:a]agate=threshold=-40dB:ratio=8:attack=5:release=150,\
      acompressor=threshold=-18dB:ratio=4:attack=10:release=200:makeup=1,\
      asplit=2[mic_mix][mic_sc];\
[1:a][mic_sc]sidechaincompress=threshold=-35dB:ratio=20:attack=20:release=300[desktop_ducked];\
[desktop_ducked][mic_mix]amix=inputs=2:dropout_transition=0,\
      pan=stereo|FL=FL|FR=FL[a]\
" \
    -map 0:v \
    -map "[a]" \
    -preset ultrafast \
    "$file" &


[[ "$!" -gt 0 ]] && notify-send -t 2000 "recording started" || exit
# Save ffmpeg PID
echo $! > /tmp/ffsrec_ffmpeg.pid

# Keep script alive until ffmpeg finishes
wait $!

# kill with this command
# $ kill -SIGINT $(cat /tmp/ffsrec_ffmpeg.pid)

# Cleanup
rm -f /tmp/ffsrec_ffmpeg.pid

GTK_THEME=Adwaita:dark yad --title "youtube-upload" \
  --center \
  --text "do you want to view your video?" \
  --button="yes:0" \
  --button="no:1" && mpv --speed=1.5 --fs "$file"

GTK_THEME=Adwaita:dark yad --title "youtube-upload" \
  --center \
  --text "do you want to upload to youtube?" \
  --button="yes:0" \
  --button="no:1" || exit

preform=$(GTK_THEME=Adwaita:dark yad --form \
    --separator="&" \
    --title='youtube-upload' \
    --center \
    --width=700 \
    --height=500 \
    --field='Title' "$name" \
    --field='Description:TXT' '' \
    --field='Privacy:CB' 'private!public!unlisted'\
    --field='tags (seperate with commas)' '')

form="$(tr '\n' '`' < <(echo -e "$preform"))"
title="$(echo $form | cut -f1 -d '&')"
predescription="$(echo $form | cut -f2 -d '&')"
description="$(tr '`' '\n' < <(echo -e "$predescription"))"
privacy="$(echo $form | cut -f3 -d '&')"
tags="$(echo $form | cut -f4 -d '&')"

# for debuging purposes
#echo -e "title:\n\t$title\ndescription:\n$description\nprivacy:\n\t$privacy\ntags:\n\t$tags"

/usr/local/bin/youtube-upload "$file" \
	--title "$title" \
	--description "$description" \
	--privacy "$privacy" \
	--tags "$tags" && notify-send "upload succeeded" || notify-send "did not upload"
